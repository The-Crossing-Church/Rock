{% assign type = Item | Attribute:'ResourceType' %}
{% assign link = Item | Attribute:'Link' %}
{{ Item.Title | SetPageTitle }}
<div class='row py-4'>
    {% if type == 'Video' %}
        <div class='col col-xs-12 col-md-5'>
            <div class='video-wrapper'>
                <iframe title="player" src="{{link | Replace:'vimeo.com','player.vimeo.com/video'}}" width="100%" height="100%" frameborder="0" allowfullscreen></iframe>
            </div>
        </div>
    {% else %}
        <div class='col col-xs-12 col-md-4'>
            <img src="{{ Item | Attribute:'Image' }}" style="width: 100%;" />
        </div>
    {% endif %}
    <div class='col col-xs-12 {% if type == 'Video' %}col-md-7{% else %}col-md-8{% endif %}'>
        <h1>{{ Item.Title }}</h1>
        <hr/>
        {% assign author = Item | Attribute:'Author' %}
        {% if author != '' %}
            <h3 class='text--upper'>{{ author }}</h3>
            <br/>
        {% endif %}
        {{ Item.Content }}
        <br/>
        {% if type == 'Book' %}
            {% if link != '' %}
                <br/>
                <a href="{{ Item | Attribute:'Link'}}" target="_blank">Get it on Amazon</a>
            {% endif %}
        {% endif %}
        {% if type == 'Audio' %}
            {% if link != '' %}
                {% if link contains 'dropbox' %}
                    {% assign link = link | Replace:'dl=0','raw=1' %}
                {% endif %}
                <div>
                    <audio controls>
                        <source src="{{link}}" type="audio/mpeg" />
                    </audio>
                </div>
            {% endif %}
        {% endif %}
        {% assign btnRaw =  Item | Attribute:'Buttons' %}
        {% if btnRaw != '' %}
            <div class="text-center">
                {% assign buttons = Item | Attribute:'Buttons' | FromJSON %}
                {% for btn in buttons %}
                    <a href="{{btn.Link}}" {% if btn.Target == 'New Tab' %}target="_blank"{% endif %} class='btn btn-primary mr-1 mt-1'>{{btn.Text}}</a>
                {% endfor %}
            </div>
        {% endif %}
    </div>
</div>

<a class='btn btn-primary' href="/Ministry/Adults/Men/Resources"><i class='fa fa-chevron-left'></i> Back</a>

<style>
    .video-wrapper {
        position: relative;
        width: 100%;
        height: 0;
        padding-bottom: 56.25%;
    }
    .video-wrapper>iframe {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
    }
</style>
