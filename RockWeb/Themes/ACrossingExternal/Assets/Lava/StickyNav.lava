{% if Item != null %}
    {% assign btnJson = Item | Attribute:'Buttons' %}
    {% assign btns = btnJson | FromJSON %}
    {% assign sz = btns | Size %}
    {% if sz > 0 %}
        <div class="sticky-nav bottom background--accent" id="divStickyNavBar">
            {% for b in btns limit:3 %}
                {% if b.Text != '' %}
                    <div class="item">
                        {% if b.Link != '' %}
                            <a class="btn btn-primary" target="{% if b.Target == 'New Tab' %}_blank{% endif %}" href="{{b.Link}}">{{b.Text}}</a>
                        {% else %}
                            <span>{{b.Text}}</span>
                        {% endif %}
                    </div>
                {% endif %}
            {% endfor %}
        </div>
    {% endif %}
    <script>
        // $(document).ready(() => {
        //     let e = document.getElementsByClassName('top')
        //     if (e.length > 0) {
        //         $('main.container').attr('style', 'padding-top: 222px !important;')
        //     }
        // })
    </script>
{% endif %}
