{% assign ct = Items | Size %}
{% if ct > 0 %}
    {% assign Item = Items[0] %}
    <br/><br/><br/>
    <div class='full-width' style="overflow: hidden;">
        <div class='sermon-section'></div>
        <div class='container sermon-overlay justify-center align-center text--white'>
            <div>
                <div class='row row-equal-height'>
                    <div class='col col-xs-12 col-md-6'>
                        <div style="float: right; max-width: 500px;">
                            <img style="width:100%;" src="{{Item | Attribute:'Image'}}" />
                        </div>
                    </div>
                    <div class='col col-xs-12 col-md-6 align-center'>
                        <div class='mobile--centered'>
                            <h2 class='text--white'>Recent Sermon</h2>
                            <h3 class='text--white'>{{Item.Title}}</h3>
                            {% assign speaker = Item | Attribute:'Author','FullName' %}
                            {% if speaker == '' or speaker == null %}
                                {% assign speaker = Item | Attribute:'GuestSpeaker' %}
                            {% endif %}
                            {% assign verses = Item | Attribute:'DisplayVerses' %}
                            {% if verses != '' and verses != null %}
                                {% capture verses %}{{verses}} | {% endcapture %}
                            {% endif %}
                            {{ verses }}{{ speaker }}
                            <br/>
                            <br/>
                            <div>
                                <a class='btn btn-accent' href="/Resources/Watch/{{Item.ContentChannel | Attribute:'ResourceCategory'}}/{{Item | Attribute:'Series'}}/{{Item.PrimarySlug}}?T=Service">Watch Service</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <br/><br/>
    <style>
    .sermon-section {
        background-image: url("https://rock.thecrossingchurch.com/Content/Home%20Page/Dave_Purple_Sermons.jpg");
        /*filter: blur(16px);
        -webkit-filter: blur(14px); */
        background-repeat: no-repeat;
        background-size: cover;
        background-position: center;
        width: 100%;
        height: 400px;
    }
    .sermon-overlay {
        position: absolute;
        top: 0;
        bottom: 0;
        left: 0;
        right: 0;
        margin: 0;
        width: 100%;
        background-color: rgba(0,0,0,0.5);
    }
    @media only screen and (max-width: 768px) {
        .mobile--centered {
            text-align: center;
            width: 100%;
        }
        .sermon-section {
            height: 500px;
        }
    }
    </style>
{% endif %}
