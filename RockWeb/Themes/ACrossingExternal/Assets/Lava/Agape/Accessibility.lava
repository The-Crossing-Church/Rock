{% assign lastSvc = 'Global' | Attribute:'ServiceTimes' | Split:',' | Last %}
<div class='row row-equal-height'>
    {% for i in Items %}
        <div class='col col-xs-12 col-md-4'>
            <div class='card--custom card-with-button' style="height:100%;">
                {[ cloudinaryimg item:i imgtype:'card' ]}
                {% comment %}<img src="{{ i | Attribute:'Image' }}" alt="{{i.Title}}" />{% endcomment %}
                <div style="padding: 8px;" class='text--centered'>
                    <strong>{{i | Attribute:'TileTitle' }}</strong>
                    <br/>
                    <p class="mb-4">
                        {{i.Content | Replace:'##LAST_SERVICE##',lastSvc}}
                    </p>
                    {% assign mapMB = i | Attribute:'MainBuildMapURL' %}
                    {% assign mapSC = i | Attribute:'StudentCenterMapURL' %}
                    {% if mapMB != '' and mapSC != '' %}
                        <a class="mr-2" style='font-weight: bold;' href="{{mapMB}}" target="_blank">Main Building <i class="ml-2 fa fa-angle-right"></i></a>
                        <a class="ml-2" style='font-weight: bold;' href="{{mapSC}}" target="_blank">Student Center <i class="ml-2 fa fa-angle-right"></i></a>
                    {% endif %}
                </div>
            </div>
        </div>
    {% endfor %}
</div>
