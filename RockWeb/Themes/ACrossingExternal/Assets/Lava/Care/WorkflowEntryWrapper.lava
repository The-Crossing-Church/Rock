<div class="modal tcc-modal modal-lg" tabindex="-1" role="dialog" id="modal_inquiry">
    <div class="modal-dialog modal-lg" role="document">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">
              title
              <button type="button" class="close pull-right" data-dismiss="modal" aria-label="Close">
                <span aria-hidden="true">&times;</span>
              </button>
          </h5>
        </div>
        <div class="modal-body">

//- Pre Above, Post Below 

        </div>
    </div>
  </div>
</div>

{% stylesheet compile:'less' import:'_variables.less' %}
    @media screen and (min-width: 1024px) {
        .tcc-modal.modal {
            width: 80% !important;
            margin-left: -40% !important;
        }
    }
    .tcc-modal .modal-content {
        border-bottom: 23px solid @color-medium-blue;
    }
    .tcc-modal.modal {
        border-radius: 4px 4px 6px 6px;
    }
{% endstylesheet %}
