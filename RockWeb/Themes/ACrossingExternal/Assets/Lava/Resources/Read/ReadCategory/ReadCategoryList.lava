{% comment %} https://rock.thecrossingchurch.com/Resources/Read/Free%20Downloads {% endcomment %}
{% assign category = 'Global' | PageParameter:'Category' %}
{{ category | SetPageTitle }}
<h1 class='text--centered pb-custom-2x'>{{category}}</h1>
<div class='row row-equal-height'>
    {% for i in Items %}
        <div class='col col-xs-12 col-sm-6 col-md-4 text--centered'>
            <a href="{{i | Attribute:'Link'}}" target="_blank">
                <div class='img-wrapper'>
                    <img src="{{i | Attribute:'Image'}}" width="100%" />
                </div>
                <h4>{{i.Title}}</h4>
                {% assign author = i | Attribute:'Author' %}
                {% if author != '' %}
                    {{author}},
                {% endif %}
                {{i.StartDateTime | Date:'MMMM dd, yyyy'}}
            </a>
        </div>
    {% endfor %}
</div>

<style>
.img-wrapper {
    height: 200px;
    overflow-y: hidden;
    position: relative;
}
.img-wrapper img {
position: absolute;
    top: 50%;
    left: 50%;
    -webkit-transform: translate(-50%,-50%);
    -ms-transform: translate(-50%,-50%);
    transform: translate(-50%,-50%);
}
</style>
