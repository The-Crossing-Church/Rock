<div class='row'>
    {% for i in Items %}
        <div class='col col-xs-12 col-md-3'>
            <a href="/Music/Listen/{{ i.PrimarySlug }}">
                <div class='card--custom card-with-button text--centered'>
                    <img src="{{i | Attribute:'Image'}}" />
                    <div class='overlay'>
                        <div>
                            <strong style="font-size: 18px;">{{i.Title}}</strong>
                            <br/>
                            Released: {{i.StartDateTime | Date:'MMMM dd, yyyy'}}
                            <br/>
                            <br/>
                        </div>
                    </div>
                </div>
            </a>
        </div>
    {% endfor %}
</div>
<style>
    .card-with-button {
        padding: 0px;
        height: 100%;
        overflow: hidden;
    }
    .col .link-wrapper {
        transform: translate(0, -50%);
    }
    .col {
        padding-bottom: 30px;
    }
    .card-with-button img {
        width: 100%;
    }
    .overlay {
        display: none;
        width: 100%;
        height: 100%;
        padding: 16px;
    }
    .card-with-button:hover .overlay, .card-with-button.tapped .overlay {
        display: flex;
        color: #fff;
        position: absolute;
        top: 0;
        bottom: 0;
        left: 0;
        right: 0;
        align-items: center;
        justify-content: center;
    }
    .card-with-button:hover img, .card-with-button.tapped img {
        filter:brightness(30%);
    }
</style>
