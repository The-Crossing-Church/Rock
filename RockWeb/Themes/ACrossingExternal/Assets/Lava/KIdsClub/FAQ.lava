{% comment %} https://rock.thecrossingchurch.com/page/1370 {% endcomment %}
{[ tccaccordion accname:'faq' ]}
    {% for i in Items %}
        {% assign title = i | Attribute:'Question' %}
        [[ item title:'{{title}}' ]]
            {{i.Content}}
        [[ enditem ]]
    {% endfor %}
{[ endtccaccordion ]}
{% comment %}
<style>
    div[id^="accordion"] div.panel-default.no-border div.panel-heading {
        background-color: #fff;
        border: none;
        border-bottom: 1px solid black;
    }
    div[id^="accordion"] div.panel-default.no-border div.panel-heading h4 {
        font-size: 1.5em;
        line-height: 1.20833em;
        letter-spacing: 1px;
        font-weight: 700;
        margin: 10px 0 0;
    }
</style>
{% endcomment %}
