{[ carousel carouselid:'gallery' itemheight:'200' ]}
    [[ title ]]
        Gallery
    [[ endtitle ]]
    {% for i in Items %}
        [[ item ]]
            <div class="img-wrapper">
                {[ cloudinaryimg item:i imgtype:'card' ]}
            </div>
        [[ enditem ]]
    {% endfor %}
{[ endcarousel ]}
