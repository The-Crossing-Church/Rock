<div class="background--grey full-width">
    <br/>
    <h2 class="text-center h1">Make a Difference</h2>
    {[ slider sliderid:'missionsPreview' containerclass:'full-width' ]}
        {% for i in Items %}
            [[ indicator target:'{{forloop.index0}}']][[ endindicator ]]
            [[ slide ]]
                  <div class='row row-equal-height'>
                    <div class='col col-xs-12 d-block d-md-none align-center'>
                      <div class='img-wrapper'>
                        {[ cloudinaryimg item:i imgtype:'card' imgclasses:'w-100' ]}
                      </div>
                    </div>
                    <div class='col col-xs-12 col-md-8 align-center'>
                      <div>
                        <h3>{{i | Attribute:'Heading'}}</h3>
                        {{i.Content}}
                        <br/>
                      </div>
                    </div>
                    <div class='col col-md-4 d-none d-md-block align-center'>
                      <div class='img-wrapper'>
                        {[ cloudinaryimg item:i imgtype:'card' imgclasses:'w-100' ]}
                      </div>
                    </div>
                  </div>
            [[ endslide ]]
        {% endfor %}
    {[ endslider ]}
</div>

{% stylesheet compile:'less' import:'_variables.less' %}
    .carousel-indicators .active[data-target="#missionsPreview"] {
        background-color: @color-light-blue;
    }
    .carousel-indicators li[data-target="#missionsPreview"] {
        border: 1px solid @color-light-blue;
    }
{% endstylesheet %}
