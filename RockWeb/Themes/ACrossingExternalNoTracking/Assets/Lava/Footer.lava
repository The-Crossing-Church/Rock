<div class="grid">
    <div class="grid-col">
        <div class="footer-section">
            <div class="footer-title">
                The Crossing
            </div>
            <ul role="menu">
                <li role="menuitem">
                    <p class="d-flex">
                        <i class="fas fa-map-marker"></i>
                        3615 Southland Drive <br/>
                        Columbia, Missouri 65201
                    </p>
                </li>
                <li role="menuitem">
                    <p class="d-flex">
                        <i class="fa"></i>
                        Phone: (573) 256-4410
                    </p>
                </li>
                <li role="menuitem">
                    <p class="d-flex">
                        <i class="fa"></i>
                        {% assign svcs = 'Global' | Attribute:'ServiceTimes' | Split:',' %}
                        Join us Sunday's in person or online at {{svcs | Join:', ' |  ReplaceLast:',',', and' }} AM CT
                    </p>
                </li>
            </ul>
        </div>
    </div>
    <div class="grid-col">
        <div class="footer-section has-collapse">
            <div class="footer-title desktop">
                <a href="https://info.thecrossingchurch.com/im-new">
                    I'm New to The Crossing
