<script lang="ts">
import { defineComponent, provide } from "vue"
import { useConfigurationValues, useInvokeBlockAction } from "@Obsidian/Utility/block"
import { CurrentPersonBag } from "@Obsidian/ViewModels/Crm/currentPersonBag"
import { ContentChannelItemBag } from "../../ViewModels/contentChannelItemBag"
import { PublicAttributeBag } from "@Obsidian/ViewModels/Utility/publicAttributeBag"
import { DatabaseProviderBlockViewModel } from "./databaseProviderDashboardBlockViewModel"
import { useStore } from "@Obsidian/PageState"
import { DateTime, Duration } from "luxon"
import rules from "../../EventForm/Rules/rules"
import helper from "../Helpers/helper"
import Details from "../Components/dashboardModal"
import Comments from "../Components/comments"
import SSPTable from "./Components/sspTable"
import GridAction from "./Components/sspGridAction"
import Grid, { Column, TextColumn, DateColumn, textValueFilter, dateValueFilter, pickExistingValueFilter } from "@Obsidian/Controls/grid"
import Modal from "@Obsidian/Controls/modal.obs"
import RockButton from "@Obsidian/Controls/rockButton.obs"
import DropDownList from "@Obsidian/Controls/dropDownList.obs"
import RockText from "@Obsidian/Controls/textBox.obs"
import RockLabel from "@Obsidian/Controls/rockLabel.obs"
import RockField from "@Obsidian/Controls/rockField.obs"
import DateRangePicker from "@Obsidian/Controls/dateRangePicker.obs"
import SupportServiceButton from "./Components/supportServiceButton"
import PartialApproval from "./Components/partialApproval"
import EditDetails from "./Components/editModal"

const store = useStore()

export default defineComponent({
  name: "EventDashboard.DatabaseProviderDashboard",
  components: {
    "rck-modal": Modal,
    "rck-btn": RockButton,
    "rck-ddl": DropDownList,
    "rck-text": RockText,
    "rck-lbl": RockLabel,
    "rck-field": RockField,
    "rck-date-range": DateRangePicker,
    "rck-grid": Grid,
    "rck-col": Column,
    "rck-col-txt": TextColumn,
    "rck-col-dt": DateColumn,
    "tcc-table": SSPTable,
    "tcc-grid": GridAction,
    "tcc-details": Details,
    "tcc-edit": EditDetails,
    "tcc-comments": Comments,
    "tcc-partial": PartialApproval,
    "tcc-ssp-btn": SupportServiceButton
  },
  setup() {
    const invokeBlockAction = useInvokeBlockAction();
    const viewModel = useConfigurationValues<DatabaseProviderBlockViewModel | null>();

    const filterRequests: (option: string, filters: any) => Promise<any> = async (option, filters) => {
      const response = await invokeBlockAction("FilterRequests", { opt: option, filters: filters });
      return response
    }
    provide("filterRequests", filterRequests);

    /** A method to load a specific request's details */
    const loadDetails: (id: string | null | undefined) => Promise<any> = async (id) => {
        const response = await invokeBlockAction("GetRequestDetails", {
            id: id
        });
        return response
    };
    provide("loadDetails", loadDetails);

    /** A method to update a request's support service status */
    const updateSupportStatus: (id: string | null | undefined, statusKey: string | null | undefined, value: string | null | undefined) => Promise<any> = async (id, statusKey, value) => {
      const response = await invokeBlockAction("ChangeSectionStatus", {
        id: id, statusKey: statusKey, value: value
      });
      return response
    };
    provide("updateSupportStatus", updateSupportStatus);

    /** A method to add a comment to the request */
    const addComment: (id: string | null | undefined, message: string | null | undefined, tags: string[] | null) => Promise<any> = async (id, message, tags) => {
      const response = await invokeBlockAction("AddComment", {
        id: id, message: message, tags: tags
      });
      return response
    };
    provide("addComment", addComment);

    /** A method to resolve a users requested changes */
    const completePartialApproval: (id: string | null | undefined, approved: string[], denied: string[], events: any[], message: string) => Promise<any> = async (id, approved, denied, events, message) => {
        const response = await invokeBlockAction("PartialApproval", {
          id: id, approved: approved, denied: denied, events: events, notes: message
        });
        return response
      }
    provide("partialApproval", completePartialApproval);

    let defaultFilters = {
      title: "",
      statuses: [ "Confirmed", "Pending Confirmation" ],
      resources: [] as string[],
      ministry: "",
      submitter: "",
      serviceStatus: 1,
      eventDates:  { lowerValue: "", upperValue: "" },
      eventModified: { lowerValue: "", upperValue: "" }
    }
    defaultFilters.eventDates.lowerValue = DateTime.now().toFormat("yyyy-MM-dd")
    let twoWeeks = Duration.fromObject({weeks: 2})
    defaultFilters.eventDates.upperValue = DateTime.now().plus(twoWeeks).toFormat("yyyy-MM-dd")

    return {
      viewModel,
      filterRequests,
      loadDetails,
      defaultFilters,
      updateSupportStatus,
      completePartialApproval,
      addComment
    }
  },
  data() {
    return {
      rules: rules,
      helper: helper,
      loading: false,
      filters: {} as any,
      textValueFilter: textValueFilter,
      dateValueFilter: dateValueFilter,
      pickExistingValueFilter: pickExistingValueFilter,
      selected: {} as ContentChannelItemBag,
      sections: [] as any,
      editCategories: [] as any,
      categoriesWithChanges: [] as any,
      createdBy: {},
      modifiedBy: {},
      modal: false,
      partialApprovalModal: false,
      editModal: false,
      comment: "",
      commentModal: false,
      toast: {
        message: "",
        class: "",
        title: "",
        titleClass: "",
        iconClass: ""
      },
      requestValidation: {} as any
    }
  },
  computed: {
    /** The person currently authenticated */
    currentPerson(): CurrentPersonBag | null {
      return store.state.currentPerson
    },
    resources() {
      if(this.helper.sectionInfo) {
        if(this.viewModel?.editCategories) {
          let cats = this.viewModel.editCategories.map(c => c.name)
          let relevantSections = this.helper.sectionInfo.filter(si => {
            return cats.includes(si.cat) && si.type
          })
          return relevantSections.map(si => {
            return { text: si.type, value: si.type }
          })
        }
      }
      return []
    },
    requestStatusOptions(): any {
      if(this.helper?.requestStatuses) {
        return this.helper.requestStatuses.filter(s => s.text != 'Draft')
      }
      return []
    },
    ministryAttr(): PublicAttributeBag | undefined {
      if(this.viewModel) {
        let event
        if(this.viewModel.events) {
          event = this.viewModel?.events[0]
        }
        if(!event && this.viewModel?.pending) {
          event = this.viewModel?.pending[0]
        }
        if(!event && this.viewModel?.cancelled) {
          event = this.viewModel?.cancelled[0]
        }
        if(this.viewModel && event) {
          let attr = event.attributes?.Ministry
          let ministryValues = this.viewModel.ministries.map(dv => {
            return { text: dv.value, description: dv.description, value: dv.guid }
          }).sort((a, b) => {
            let textA = a.text ?? ""
            let textB = b.text ?? ""
            if (textA < textB) {
              return -1
            } else if(textA > textB) {
              return 1
            }
            return 0
          })
          if(attr?.configurationValues?.values) {
            attr.configurationValues.values = JSON.stringify(ministryValues)
          }
          return attr
        }
      }
      return undefined
    },
    sspActions() {
      let sspActions = [] as any[]
      if(this.selected?.attributes && this.selected?.attributeValues && this.editCategories?.length > 0) {
        this.editCategories?.forEach(cat => {
          let info = helper.sectionInfo.filter(si => {
            return cat == si.cat
          })[0]
          if(!this.categoriesWithChanges.includes(cat)) {
            //Verify that the action does not have any pending changes that need to be resolved 
            //before the SSP can take action on the status of the support service
            let statusKey = info.status
            let statusAttr = this.selected?.attributes[statusKey] as any
            let serviceKey = info.attr
            let service = this.selected?.attributeValues[serviceKey]
            if(statusAttr && service == 'True') {
              let options = JSON.parse(statusAttr.configurationValues.values)
              let status = this.selected?.attributeValues[statusKey]
              let currentStatus = options.filter(opt => opt.value == status)
              if(currentStatus && currentStatus.length > 0) {
                currentStatus = currentStatus[0]
              } else {
                currentStatus = options[0]
              }
              options.filter(opt => opt.value != status).forEach(opt => {
                sspActions.push({ service: info.section, action: opt.text, value: opt.value, statusKey: statusKey })
              })
            }
          }
        })
      }
      return sspActions
    },
  },
  methods: {
    filter(opt: string) {
      this.loading = true
      this.filterRequests(opt, this.filters).then((response: any) => {
        if(this.viewModel) {
          console.log(response)
          if(opt == "Upcoming") {
            this.viewModel.events = response.data
          } else if (opt == "Pending") {
            this.viewModel.pending = response.data
          } else {
            this.viewModel.cancelled = response.data
          }
          this.loading = false
        }
      }).catch((ex: any) => {
        console.error(ex)
        this.loading = false
      })
    },
    resetFilters() {
      this.filters = this.defaultFilters
    },
    getIsValid(r: any) {
      return r?.attributeValues?.RequestIsValid == 'True'
    },
    btnColor(row) {
      return row.attributeValues?.RequestStatus?.replaceAll(" ", "").toLowerCase().replace("legacyrequest", "default")
    },
    selectItem(item: any) { 
      let el = document.getElementById('updateProgress')
      if(el) {
        el.style.display = 'block'
      }
      this.loadDetails(item.idKey).then((response: any) => {
        if(response.isError) {
          this.toast = {
            message: response.errorMessage,
            class: "show",
            title: "System Exception",
            titleClass: "toast-header text-red",
            iconClass: "fas fa-exclamation-triangle mr-1" 
          }
        } else if(response.data) {
          response.data.details?.forEach((detail: any) => {
            detail.detail.changes = detail.detailChanges
          })
          response.data.request.childItems = response.data.details.map((detail: any) => { return detail.detail }).sort((a: any, b: any) => {
            let aDate = DateTime.fromFormat(a.attributeValues.EventDate, 'yyyy-MM-dd')
            let bDate = DateTime.fromFormat(b.attributeValues.EventDate, 'yyyy-MM-dd')
            if(aDate < bDate) {
              return -1
            } else if (aDate > bDate) {
              return 1
            }
            return 0
          })
          response.data.request.changes = response.data.requestChanges
          response.data.request.comments = response.data.comments
          // response.data.request.conflicts = response.data.conflicts
          // response.data.request.changesConflicts = response.data.changesConflicts
          this.selected = response.data.request
          let viewCategories = this.viewModel?.viewCategories.map(c => c.name)
          this.editCategories = this.viewModel?.editCategories.map(c => c.name)
          this.sections = helper.sectionInfo.filter(si => {
            return this.editCategories?.includes(si.cat) || viewCategories?.includes(si.cat)
          }).map(si => si.type )
          this.createdBy = response.data.createdBy
          this.modifiedBy = response.data.modifiedBy
          this.modal = true
          this.requestValidation = this.rules.validate(this.selected, response.data.request?.childItems, this.viewModel?.locations, this.viewModel?.ministries, true)
          if(this.selected?.attributeValues?.RequestErrors) {
            this.requestValidation.errors = JSON.parse(this.selected?.attributeValues?.RequestErrors as string)
          }
          if(this.selected?.attributeValues?.RequestStatus == "Pending Changes") {
            this.processEventChanges()
          } else {
            this.categoriesWithChanges = []
          }
        }
      }).catch((ex) => {
        console.log(ex)
        this.toast = {
          message: ex,
          class: "show",
          title: "System Exception",
          titleClass: "toast-header text-red",
          iconClass: "fas fa-exclamation-triangle mr-1" 
        }
      }).finally(() => {
        if(el) {
          el.style.display = 'none'
        }
      })
    },
    newComment() {
      this.comment = ""
      this.commentModal = true
    },
    createComment(comment: string, tags: string[]) {
      let el = document.getElementById('updateProgress')
      if(el) {
        el.style.display = 'block'
      }
      this.addComment(this.selected.idKey, comment, tags).then((res: any) => {
        if(res.isSuccess) {
          if(res.data?.comment) {
            let req = this.selected as any
            req.comments.push(res.data)
          }
        } else if (res.isError) {
          this.toast = {
            message: res.errorMessage,
            class: "show",
            title: "System Exception",
            titleClass: "toast-header text-red",
            iconClass: "fas fa-exclamation-triangle mr-1" 
          }
        }
        this.commentModal = false
      }).finally(() => {
        if(el) {
          el.style.display = 'none'
        }
      })
    },
    updateSupportService(statusKey: string, value: string) {
      if(this.selected) {
        this.updateSupportStatus(this.selected.idKey, statusKey, value)
          .then((res) => {
            console.log('success')
            console.log(res)
            if(res.isError) {
              throw res.errorMessage
            }
            this.toast = {
              message: res.data,
              class: "toast-success show",
              title: "Request Updated",
              titleClass: "toast-header text-success",
              iconClass: "fas fa-check-circle mr-1" 
            }
            if(this.selected.attributeValues) {
              this.selected.attributeValues[statusKey] = value
            }
          }).catch((ex) => {
            this.toast = {
              message: ex,
              class: "show",
              title: "System Exception",
              titleClass: "toast-header text-red",
              iconClass: "fas fa-exclamation-triangle mr-1" 
            }
          })
      }
    },
    hideToast() {
      let el = document.getElementById('toast')
      el?.classList.remove("show")
    },
    processEventChanges() {
      //Method to determine what sections have pending changes and if the SSP needs to   
      //resolve those before taking action on the status of their support service 
      let request = this.selected as any
      let updatedAttributeCategories = [] as any
      if(request?.attributeValues && request?.changes?.attributeValues) {
        Object.keys(request.attributeValues).forEach(key => {
          if(request.attributeValues[key] != request.changes.attributeValues[key]) {
            if(request.attributes[key] && request.attributes[key].categories?.length > 0) {
              updatedAttributeCategories.push(...request.attributes[key]?.categories?.map(c => c.name))
            }
          }
        })
        request.childItems.forEach(detail => {
          Object.keys(detail.attributeValues).forEach(key => {
            if(detail.attributeValues[key] != detail.changes.attributeValues[key]) {
              if(detail.attributes[key] && detail.attributes[key].categories?.length > 0) {
                updatedAttributeCategories.push(...detail.attributes[key].categories.map(c => c.name))
              }
            }
          })
        })
      }
      this.categoriesWithChanges = updatedAttributeCategories.filter((cat, idx, list) => {
        if(cat && list.indexOf(cat) == idx) {
          return this.editCategories.includes(cat)
        }
        return false
      })
    },
    partialApproval() {
      let ref = this.$refs.partialApprovalInfo as any
      let approved = ref.approvedAttributes as string[]
      let denied = ref.deniedAttributes as string[]
      let events = ref.eventChanges as any[]
      let message = ref.message as string
      let el = document.getElementById('updateProgress')
      if(el) {
        el.style.display = 'block'
      }

      this.completePartialApproval(this.selected.idKey, approved, denied, events, message).then((res) => {
        this.partialApprovalModal = false
        if(res.isSuccess) {
          if(res.data?.id) {
            this.selectItem({ idKey: res.data.id })
          }
        } else if (res.isError) {
          this.toast = {
            message: res.errorMessage,
            class: "show",
            title: "System Exception",
            titleClass: "toast-header text-red",
            iconClass: "fas fa-exclamation-triangle mr-1" 
          }
          if(el) {
            el.style.display = 'none'
          }
        }
      })
    }
  },
  watch: {
    
  },
  mounted() {
    this.resetFilters()
    this.filter("Upcoming")
    this.filter("Pending")
    this.filter("Cancelled")

    // Load item from URL 
    let params = new URLSearchParams(window.location.search)
    let id = params.get("Id")
    if(id) {
      this.selectItem({idKey: id})
    }
  },
  template: `
<div class="card mb-2">
  <tcc-table :openByDefault="true" option="Pending Confirmation" :events="viewModel.pending" :ministryAttr="ministryAttr" :resources="resources" v-on:updatestatus="updateFromGridAction" v-on:selectitem="selectItem"></tcc-table>
</div>
<div class="card mb-2">
  <tcc-table :openByDefault="false" option="Cancelled" :events="viewModel.cancelled" :ministryAttr="ministryAttr" :resources="resources" v-on:updatestatus="updateFromGridAction" v-on:selectitem="selectItem"></tcc-table>
</div>
<div class="card">
  <div style="display: flex; align-items: center;">
    <i class="fa fa-filter mr-2 mb-2 hover fa-lg" data-toggle="collapse" data-target="#filterCollapse" aria-expanded="false" aria-controls="filterCollapse"></i>
    <h4 style="width: 90%;" class="text-primary hover" data-toggle="collapse" data-target="#allCollapse" aria-expanded="false" aria-controls="allCollapse">Everything Else</h4>
  </div>
  <div class="collapse" id="allCollapse">
    <div class="collapse" id="filterCollapse">
      <div class="row">
        <div class="col col-xs-12 col-md-4">
          <rck-text
            label="Request Name"
            v-model="filters.title"
          ></rck-text>
        </div>
        <div class="col col-xs-12 col-md-4">
          <rck-text
            label="Submitter/Modifier"
            v-model="filters.submitter"
          ></rck-text>
        </div>
        <div class="col col-xs-12 col-md-4" v-if="ministryAttr">
          <rck-field
            v-model="filters.ministry"
            :attribute="ministryAttr"
            :is-edit-mode="true"
          ></rck-field>
        </div>
      </div>
      <div class="row">
        <div class="col col-xs-12 col-md-4">
          <rck-ddl
            label="Request Status"
            :items="requestStatusOptions"
            v-model="filters.statuses"
            multiple
          ></rck-ddl>
        </div>
        <div class="col col-xs-12 col-md-4">
          <rck-ddl
            label="Requested Resources"
            :items="helper.resources"
            v-model="filters.resources"
            multiple
          ></rck-ddl>
        </div>
        <div class="col col-xs-12 col-md-4">
          <rck-date-range
            label="Has Event Date in Range"
            v-model="filters.eventDates"
          ></rck-date-range>
        </div>
      </div>
      <div class="row">
        <div class="col col-xs-12 col-md-4">
          <rck-date-range
            label="Modified in Range"
            v-model="filters.eventModified"
          ></rck-date-range>
        </div>
      </div>
      <div class="row mb-4">
        <div class="col col-xs-12">
          <rck-btn class="mr-1" btnType="accent" @click="resetFilters">Reset Defaults</rck-btn>
          <rck-btn btnType="grey" @click="clearFilters">Clear Filters</rck-btn>
          <rck-btn class="pull-right" btnType="primary" @click="filter('Upcoming')" :isLoading="loading">Filter</rck-btn>
        </div>
      </div>
    </div>
    <rck-grid :data="{ rows: this.viewModel.events }" keyField="idKey" :isTitleHidden="true" itemTerm="request" :emptyDataText="loading ? 'Loading Requests...' : 'No Requests to Display'">
      <rck-col-txt
        name="title"
        title="Title"
        field="title"
        :filter="textValueFilter"
      >
        <template #format="{ row }">
          <div class="hover w-100" @click="selectItem(row)">
            <i v-if="getIsValid(row)" class="fa fa-check-circle text-accent mr-2"></i>
            <i v-else class="fa fa-exclamation-circle text-inprogress mr-2"></i> 
            {{ row.title }}
          </div>
        </template>
      </rck-col-txt>
      <rck-col-txt
        name="createdBy"
        title="Submitted By"
        field="createdBy"
        :filter="pickExistingValueFilter"
        visiblePriority="md"
      ></rck-col-txt>
      <rck-col
        name="attributeValues.EventDates"
        title="Event Dates"
        field="attributeValues.EventDates"
        :filter="dateValueFilter"
        :filterValues="helper.getDatesFilterValues"
      >
        <template #format="{ row }">
          {{ helper.formatDates(row.attributeValues.EventDates) }}
        </template>
      </rck-col>
      <rck-col
        name="attributeValues.RequestType"
        title="Requested Resources"
        field="attributeValues.RequestType"
        :filter="pickExistingValueFilter"
        :filterValues="helper.getRequestTypeFilterValues"
        visiblePriority="md"
      >
        <template #format="{ row }">
          {{ row.attributeValues.RequestType?.replaceAll(',', ', ') }}
        </template>
      </rck-col>
      <rck-col
        name="attributeValues.RequestStatus"
        title="Status"
        field="attributeValues.RequestStatus"
        itemClass="overflow-visible"
        :filter="pickExistingValueFilter"
        :filterValue="helper.getRequestStatusFilterValue"
        :quickFilterValue="helper.getRequestStatusFilterValue"
        :sortValue="helper.getRequestStatusSortValue"
      >
        <template #format="{ row }">
          <tcc-grid :request="row" v-on:updatestatus="updateFromGridAction"></tcc-grid>
        </template>
      </rck-col>
    </rck-grid>
  </div>
</div>

<rck-modal v-model="modal" width="80%" isCloseButtonHidden cancelText="" clickBackdropToClose modalWrapperClasses="modal-no-header">
  <tcc-details 
    :request="selected" 
    :rooms="viewModel.locations" 
    :drinks="viewModel.drinks" 
    :inventory="viewModel.inventory" 
    :createdBy="createdBy" 
    :modifiedBy="modifiedBy" 
    :requestValidation="requestValidation" 
    :sections="sections"
    :editCategories="editCategories"
    v-on:openrequest="selectItem"
  ></tcc-details>
  <template v-if="commentModal || (selected.comments && selected.comments.length > 0)">
    <tcc-comments role="SSP" :comments="selected.comments" :request="selected" v-model="commentModal" v-on:createComment="createComment"></tcc-comments>
  </template>
  <template #customButtons>
    <div class="d-flex modal-button-wrapper w-100">
      <rck-btn v-if="categoriesWithChanges.length > 0" btnType="primary" @click="partialApprovalModal = true">
        <i class="mr-1 fas fa-tasks"></i>
        Resolve Changes
      </rck-btn>
      <rck-btn v-else btnType="primary" @click="editModal = true">
        <i class="mr-1 fa fa-pencil-alt"></i>
        Edit
      </rck-btn>
      <tcc-ssp-btn
        v-for="action in sspActions"
        :service="action.service"
        :action="action.action"
        :value="action.value"
        :statusKey="action.statusKey"
        emits="updateSupportService"
        v-on:updateSupportService="updateSupportService"
      ></tcc-ssp-btn>
      <rck-btn btnType="accent" @click="newComment">
        <i class="mr-1 fa fa-comment-alt"></i>
        Add Comment
      </rck-btn>
      <div class="btn-spacer"></div>
      <rck-btn btnType="default" @click="modal = false;">
        <i class="mr-1 ti ti-window-minimize"></i>
        Close
      </rck-btn>
    </div>
  </template>
</rck-modal>

<rck-modal v-if="partialApprovalModal" v-model="partialApprovalModal" width="70%" isCloseButtonHidden cancelText="" clickBackdropToClose modalWrapperClasses="modal-no-header">
  <h4>Partial Approval for: {{selected.title}}</h4>
  <p>
    Changes have been requested for this event. Please approve or deny each change request for items related to your support service.
  </p>
  
  <tcc-partial
    :request="selected" 
    :rooms="viewModel.locations" 
    :inventory="viewModel.inventory" 
    :editCategories="editCategories"
    ref="partialApprovalInfo"
  ></tcc-partial>
  
  <template #customButtons>
    <rck-btn btnType="accent" @click="partialApproval">
      <i class="mr-1 fa fa-check"></i>
      Complete
    </rck-btn>
    <rck-btn btnType="grey" @click="partialApprovalModal = false;">
      <i class="mr-1 fa fa-ban"></i>
      Cancel
    </rck-btn>
  </template>
</rck-modal>

<rck-modal v-model="editModal" width="80%" isCloseButtonHidden cancelText="" clickBackdropToClose modalWrapperClasses="modal-no-header">
  <h4>Edit: {{selected.title}}</h4>
  <tcc-edit
    :request="selected" 
    :editCategories="editCategories"
    :regAttrs="viewModel.reqQuestionAttrs"
    :discountAttrs="viewModel.discountCodeAttrs"
  ></tcc-edit>
  
  <template #customButtons>
    <rck-btn btnType="accent" @click="save">
      <i class="mr-1 ti ti-device-floppy"></i>
      Save
    </rck-btn>
    <rck-btn btnType="grey" @click="editModal = false;">
      <i class="mr-1 fa fa-ban"></i>
      Cancel
    </rck-btn>
  </template>
</rck-modal>

<div id="toast" role="alert" :class="toast.class">
  <div :class="toast.titleClass">
    <i :class="toast.iconClass"></i>
    <strong>{{toast.title}}</strong>
    <i class="fa fa-times pull-right hover" @click="hideToast"></i>
  </div>
  <div class="toast-body">
    {{toast.message}}
  </div>
</div>

<v-style>
  @import "/Styles/Blocks/Plugins/eventForm.css";

  .status-box {
    padding: 4px 8px;
    border: 2px solid;
    border-radius: 8px;
    font-weight: 500;
    font-size: 1.1em;
  }
</v-style>
`
})
</script>